---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DrawingA4 from '../components/DrawingA4.astro';

// Die drei Punkte, an denen sich PDF Engineer von anderen PDF-Werkzeugen unterscheidet. Ohne
// Namen zu nennen: Es geht darum, was hier gilt, nicht darum, was anderswo fehlt.
const reasons = [
  {
    number: '01',
    title: 'Wirklich lokal',
    text: 'Viele PDF-Seiten versprechen, dass nichts hochgeladen wird. Bei uns sorgt dein Browser dafür. Er lässt die Seite gar nicht erst mit fremden Servern reden.',
  },
  {
    number: '02',
    title: 'Aus Deutschland',
    text: 'Die Seite wird in Deutschland betrieben und gehostet. Es gibt kein Google, kein Tracking und keine Dienste von Dritten. Gut also auch für Verträge, Arztbriefe oder Bewerbungen.',
  },
  {
    number: '03',
    title: 'Lieber wenig, dafür gut',
    text: 'Hier gibt es keine endlose Liste an Funktionen, sondern ein paar Werkzeuge, die richtig gut funktionieren. Auch mit passwortgeschützten Dateien und großen Scans.',
  },
];

const specs = [
  { term: 'Verarbeitung', value: 'Direkt in deinem Browser' },
  { term: 'Upload', value: 'Keiner' },
  { term: 'Anmeldung', value: 'Brauchst du nicht' },
  { term: 'Kosten', value: 'Keine, auch kein Wasserzeichen' },
  { term: 'Cookies', value: 'Keine, auch kein Tracking' },
  { term: 'Fremde Dienste', value: 'Keine, auch keine Google Fonts' },
  { term: 'Betrieb', value: 'Aus Deutschland, gehostet bei Strato' },
  { term: 'Dateigröße', value: 'Nur durch den Speicher deines Geräts begrenzt' },
  { term: 'Offline', value: 'Geht, sobald Seite und Dateien geladen sind' },
  { term: 'Quellcode', value: 'Offen (AGPL-3.0)' },
];
---

<Layout
  title="PDF Engineer – PDFs zusammenfügen, teilen und komprimieren ohne Upload"
  description="PDFs kostenlos zusammenfügen, teilen und komprimieren, direkt im Browser. Deine Dateien werden nicht hochgeladen, und du brauchst keine Anmeldung."
>
  <PageHero
    size="large"
    title={'PDFs bearbeiten,<br class="hidden sm:block" /> <span class="text-signal">ohne sie hochzuladen.</span>'}
    lead="Zusammenfügen, teilen und komprimieren geht hier direkt in deinem Browser. Deine Dateien bleiben auf deinem Gerät, wir bekommen sie nie zu sehen."
  >
    <a href="/sicherheit/" class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-signal hover:underline">
      Selbst nachprüfen, dass nichts hochgeladen wird <span aria-hidden="true">→</span>
    </a>
    <TrustBadges />
    <DrawingA4 slot="aside" />
  </PageHero>

  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <SectionHeading id="werkzeuge" label="Werkzeuge" title="Was du hier machen kannst" />
    <div class="grid gap-4 md:grid-cols-3">
      <a
        href="/pdf-zusammenfuegen/"
        class="group crop-marks flex flex-col rounded-2xl border border-rule bg-sheet p-6 transition hover:border-signal/50 hover:shadow-[0_12px_40px_-16px_rgb(29_91_214/0.35)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
      >
        <div class="flex items-start justify-between">
          <span class="grid size-11 place-items-center rounded-xl bg-signal/10 text-signal">
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M8 3h6l4 4v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke-linejoin="round"></path>
              <path d="M10 21h7a3 3 0 0 0 3-3V9" stroke-linecap="round"></path>
              <path d="M9 9h5M9 12h5" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="label">Werkzeug 01</span>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-ink">PDF zusammenfügen</h3>
        <p class="mt-2 text-sm leading-relaxed text-graphite">
          Mach aus mehreren PDFs eine. Die Reihenfolge bestimmst du, und auch passwortgeschützte Dateien gehen.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-signal">
          Öffnen <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </span>
      </a>

      <a
        href="/pdf-komprimieren/"
        class="group crop-marks flex flex-col rounded-2xl border border-rule bg-sheet p-6 transition hover:border-signal/50 hover:shadow-[0_12px_40px_-16px_rgb(29_91_214/0.35)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
      >
        <div class="flex items-start justify-between">
          <span class="grid size-11 place-items-center rounded-xl bg-signal/10 text-signal">
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M8 3h6l4 4v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke-linejoin="round"></path>
              <path d="M12 8v3m0 0-1.5-1.5M12 11l1.5-1.5M12 17v-3m0 0-1.5 1.5M12 14l1.5 1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="label">Werkzeug 02</span>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-ink">PDF komprimieren</h3>
        <p class="mt-2 text-sm leading-relaxed text-graphite">
          Mach große PDFs kleiner, zum Beispiel für E-Mail-Anhänge. Der Text bleibt dabei scharf und markierbar.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-signal">
          Öffnen <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </span>
      </a>

      <a
        href="/pdf-teilen/"
        class="group crop-marks flex flex-col rounded-2xl border border-rule bg-sheet p-6 transition hover:border-signal/50 hover:shadow-[0_12px_40px_-16px_rgb(29_91_214/0.35)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
      >
        <div class="flex items-start justify-between">
          <span class="grid size-11 place-items-center rounded-xl bg-signal/10 text-signal">
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 4h6v16H4zM14 4h6v16h-6z" stroke-linejoin="round"></path>
              <path d="M12 2v20" stroke-linecap="round" stroke-dasharray="2 2"></path>
            </svg>
          </span>
          <span class="label">Werkzeug 03</span>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-ink">PDF teilen</h3>
        <p class="mt-2 text-sm leading-relaxed text-graphite">
          Trenn eine PDF genau dort, wo du willst. Du siehst alle Seiten und setzt die Trennstellen selbst.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-signal">
          Öffnen <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <SectionHeading label="Warum hier" title="Warum PDF Engineer?" />
    <div class="grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule md:grid-cols-3">
      {
        reasons.map((reason) => (
          <div class="bg-sheet p-6">
            <p class="font-mono text-sm text-mark">{reason.number}</p>
            <h3 class="mt-3 text-lg font-semibold text-ink">{reason.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-graphite">{reason.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <SectionHeading label="Datenblatt" title="Auf einen Blick" />
    <dl class="grid overflow-hidden rounded-2xl border border-rule bg-sheet sm:grid-cols-2">
      {
        specs.map((spec, index) => (
          <div
            class:list={[
              'flex flex-col gap-1 border-rule px-5 py-4 sm:flex-row sm:gap-6',
              index > 0 && 'border-t',
              index === 1 && 'sm:border-t-0',
              index % 2 === 1 && 'sm:border-l',
            ]}
          >
            <dt class="label shrink-0 pt-0.5 sm:w-36">{spec.term}</dt>
            <dd class="text-sm text-ink">{spec.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <div class="relative isolate overflow-hidden rounded-2xl border border-rule bg-sheet px-6 py-10 sm:px-10">
      <div class="blueprint absolute inset-0 -z-10 opacity-80" aria-hidden="true"></div>
      <p class="label">Selbsttest</p>
      <h2 class="mt-3 max-w-xl text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Du musst uns nicht glauben.</h2>
      <p class="mt-3 max-w-xl text-graphite">
        Füg deine Dateien hinzu und schalte dann das WLAN aus. Das Zusammenfügen klappt trotzdem, weil dafür nichts
        übers Internet muss.
      </p>
      <a href="/sicherheit/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-signal hover:underline">
        So testest du es <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
