---
import Dropzone from './Dropzone.astro';
import { LEVELS } from '../lib/compress';

// Oberfläche zum Komprimieren. Die Logik steht in src/scripts/compress-tool.ts.
const button =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
const primary = 'bg-signal text-on-signal shadow-sm hover:bg-signal-strong';
const secondary = 'border border-rule bg-sheet text-ink hover:border-rule-strong';
---

<section id="compress-tool" class="crop-marks rounded-2xl border border-rule bg-sheet shadow-[0_1px_0_var(--color-rule),0_12px_40px_-16px_rgb(14_24_40/0.18)]">
  <div class="flex items-center justify-between border-b border-rule px-4 py-3 sm:px-5">
    <p class="label">Eingabe</p>
    <p data-count class="font-mono text-xs text-graphite">0 Dateien</p>
  </div>

  <div class="p-4 sm:p-5">
    <Dropzone />
    <ol data-list class="mt-4 space-y-2 empty:mt-0" aria-label="Ausgewählte PDFs"></ol>
  </div>

  <div data-actions hidden class="border-t border-rule bg-sunken/60 px-4 py-4 sm:px-5">
    <fieldset>
      <legend class="label">Stärke</legend>
      <div class="mt-3 grid gap-2 sm:grid-cols-3">
        {
          Object.entries(LEVELS).map(([key, level]) => (
            <label class="relative flex cursor-pointer flex-col rounded-xl border border-rule bg-sheet p-3 transition hover:border-rule-strong has-checked:border-signal has-checked:shadow-[inset_0_0_0_1px_var(--color-signal)] has-focus-visible:outline-2 has-focus-visible:outline-signal">
              <input type="radio" name="level" value={key} checked={key === 'mittel'} class="sr-only" />
              <span class="flex items-baseline justify-between gap-2">
                <span class="font-medium text-ink">{level.label}</span>
                <span class="font-mono text-[11px] text-graphite">{level.dpi} dpi</span>
              </span>
              <span class="mt-1 text-xs leading-snug text-graphite">{level.note}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p data-summary class="font-mono text-xs tracking-wide text-ink"></p>
        <p data-hint class="mt-1 text-xs text-graphite empty:hidden"></p>
      </div>
      <div class="flex gap-2">
        <button data-clear type="button" class:list={[button, secondary]}>Alle entfernen</button>
        <button data-compress type="button" class:list={[button, primary]}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M10 2v5m0 0-2.5-2.5M10 7l2.5-2.5M10 18v-5m0 0-2.5 2.5M10 13l2.5 2.5M4 10h12" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Komprimieren
        </button>
      </div>
    </div>
    <p data-status role="status" aria-live="polite" class="mt-3 text-sm text-ink empty:hidden"></p>
  </div>
</section>

<script>
  import '../scripts/compress-tool';
</script>
