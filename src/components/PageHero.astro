---
// Kopf jeder Seite: technische Beschriftung, Überschrift, Einleitung, darunter optional mehr
// (Plaketten, Knöpfe) und rechts daneben eine Zeichnung. Das Raster liegt als eigene Ebene
// dahinter, weil es nach unten ausgeblendet wird und diese Maske sonst auch den Text träfe.
interface Props {
  label?: string;
  // Der Weg zur Seite, vor der Beschriftung, etwa Start / Werkzeuge. Die Zeile sieht aus wie ein
  // Pfad, also muss man ihn auch zurückgehen können. Die Beschriftung selbst ist die aktuelle
  // Seite und deshalb kein Link.
  crumbs?: { href: string; text: string }[];
  title: string;
  lead?: string;
  size?: 'large' | 'normal';
}
const { label, crumbs = [], title, lead, size = 'normal' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="relative isolate overflow-hidden border-b border-rule">
  <div class="blueprint absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class:list={[
      'mx-auto max-w-6xl px-4 sm:px-6',
      size === 'large' ? 'pt-16 pb-14 sm:pt-24 sm:pb-20' : 'pt-12 pb-10 sm:pt-16 sm:pb-12',
      hasAside && 'lg:grid lg:grid-cols-[1fr_22rem] lg:items-center lg:gap-12',
    ]}
  >
    <div>
      {
        label && (
          <nav aria-label="Pfad" class="label flex flex-wrap items-center gap-x-2.5 gap-y-1">
            <span class="h-px w-6 bg-mark" aria-hidden="true" />
            {crumbs.map((crumb) => (
              <>
                <a
                  href={crumb.href}
                  class="text-signal underline decoration-signal/40 underline-offset-4 transition hover:decoration-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                >
                  {crumb.text}
                </a>
                <span aria-hidden="true">/</span>
              </>
            ))}
            <span aria-current={crumbs.length > 0 ? 'page' : undefined}>{label}</span>
          </nav>
        )
      }
      <h1
        class:list={[
          'max-w-3xl font-semibold tracking-tight text-balance text-ink',
          label && 'mt-4',
          size === 'large' ? 'text-4xl leading-[1.05] sm:text-6xl' : 'text-3xl leading-tight sm:text-5xl',
        ]}
        set:html={title}
      />
      {lead && <p class="mt-5 max-w-2xl text-lg text-pretty text-graphite">{lead}</p>}
      <slot />
    </div>
    {hasAside && <div class="hidden lg:block"><slot name="aside" /></div>}
  </div>
</section>
