---
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule sm:grid-cols-3">
  {
    steps.map((step, index) => (
      <li class="bg-sheet p-6">
        <p class="font-mono text-sm text-signal">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="mt-3 font-semibold text-ink">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-graphite">{step.text}</p>
      </li>
    ))
  }
</ol>
