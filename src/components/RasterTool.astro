---
import PdfIntake from './PdfIntake.astro';

// Oberfläche für PDF in Bild. Die Logik steht in src/scripts/raster-tool.ts.
const button =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
const primary = 'bg-signal text-on-signal shadow-sm hover:bg-signal-strong';
const segment =
  'cursor-pointer rounded-lg px-3 py-1.5 text-sm text-graphite transition hover:text-ink has-checked:bg-signal has-checked:text-on-signal has-focus-visible:outline-2 has-focus-visible:outline-signal has-disabled:cursor-not-allowed';
const formats = [
  { value: 'jpg', label: 'JPG' },
  { value: 'png', label: 'PNG' },
];
const resolutions = [
  { value: '72', label: '72 dpi' },
  { value: '150', label: '150 dpi' },
  { value: '300', label: '300 dpi' },
];
---

<section id="raster-tool" class="crop-marks rounded-2xl border border-rule bg-sheet shadow-[0_1px_0_var(--color-rule),0_12px_40px_-16px_rgb(14_24_40/0.18)]">
  <div class="flex items-center justify-between border-b border-rule px-4 py-3 sm:px-5">
    <p class="label">Eingabe</p>
    <p data-count class="font-mono text-xs text-graphite">Keine Datei</p>
  </div>

  <div class="p-4 sm:p-5">
    <PdfIntake />
  </div>

  <div data-actions hidden class="border-t border-rule bg-sunken/60 px-4 py-4 sm:px-5">
    <div class="flex flex-wrap gap-x-8 gap-y-4">
      <fieldset>
        <legend class="label">Format</legend>
        <div class="mt-3 inline-flex rounded-xl border border-rule bg-sheet p-1">
          {
            formats.map((format) => (
              <label class={segment}>
                <input type="radio" name="format" value={format.value} checked={format.value === 'jpg'} class="sr-only" />
                {format.label}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend class="label">Auflösung</legend>
        <div class="mt-3 inline-flex rounded-xl border border-rule bg-sheet p-1">
          {
            resolutions.map((resolution) => (
              <label class={segment}>
                <input type="radio" name="dpi" value={resolution.value} checked={resolution.value === '150'} class="sr-only" />
                {resolution.label}
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
    <p class="mt-2 text-xs text-graphite">
      JPG ist kleiner und gut für Fotos und Scans, PNG ist verlustfrei und gut für Text und Grafiken. 150 dpi passt für den
      Bildschirm, 300 dpi zum Drucken.
    </p>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p data-summary class="font-mono text-xs tracking-wide text-ink"></p>
      <button data-convert type="button" class:list={[button, primary]}>
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="4" width="14" height="12" rx="1.5"></rect>
          <path d="m3 13 4-4 3 3 2-2 5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        In Bilder umwandeln
      </button>
    </div>
    <div data-progress hidden class="mt-3">
      <div class="h-1.5 overflow-hidden rounded-full bg-sheet">
        <div data-progress-bar class="h-full w-0 rounded-full bg-signal transition-[width] duration-300"></div>
      </div>
    </div>
    <p data-status role="status" aria-live="polite" class="mt-2 text-sm text-ink empty:hidden"></p>
  </div>

  <div data-result hidden class="border-t border-rule px-4 py-4 sm:px-5">
    <div class="rounded-xl border border-ok/30 bg-ok/8 p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ok text-sheet" aria-hidden="true">
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="m5 10.5 3.2 3L15 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <p data-result-title class="font-medium text-ink"></p>
        </div>
        <button data-zip type="button" class:list={[button, primary]}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Alle als ZIP
        </button>
      </div>
      {/* grid-cols-1 statt nur sm:grid-cols-2: Ohne feste Spalte wächst sie am Handy auf die Länge des
          Dateinamens, und der Knopf ragt aus dem Kasten. */}
      <ul data-images class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2"></ul>
    </div>
  </div>
</section>

<script>
  import '../scripts/raster-tool';
</script>
