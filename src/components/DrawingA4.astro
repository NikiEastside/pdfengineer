---
// Technische Zeichnung eines PDF-Stapels: drei Blätter, das vorderste bemaßt wie ein
// DIN-A4-Blatt (210 × 297 mm, Maßstab 1:1,2 in Pixeln). Reine Dekoration für die Startseite.
---

<svg viewBox="0 0 360 440" class="w-full" fill="none" aria-hidden="true">
  <!-- Stapel dahinter -->
  <rect x="78" y="22" width="252" height="356" rx="3" class="fill-sheet stroke-rule-strong" stroke-width="1.2"></rect>
  <rect x="64" y="36" width="252" height="356" rx="3" class="fill-sheet stroke-rule-strong" stroke-width="1.2"></rect>

  <!-- vorderstes Blatt mit Eselsohr -->
  <path d="M53 50h190l39 39v317H53z" class="fill-sheet stroke-signal" stroke-width="1.6" stroke-linejoin="round"></path>
  <path d="M243 50v39h39" class="stroke-signal" stroke-width="1.6" stroke-linejoin="round"></path>

  <!-- Inhalt: Überschrift, Textzeilen, Bildfläche -->
  <rect x="77" y="78" width="110" height="10" rx="2" class="fill-signal/80"></rect>
  <g class="stroke-graphite/40" stroke-width="5" stroke-linecap="round">
    <path d="M77 108h178M77 124h178M77 140h140"></path>
    <path d="M77 300h178M77 316h178M77 332h178M77 348h96"></path>
  </g>
  <rect x="77" y="162" width="178" height="116" rx="3" class="fill-signal/8 stroke-signal/50" stroke-width="1.2" stroke-dasharray="4 4"></rect>
  <path d="M77 162l178 116M255 162L77 278" class="stroke-signal/30" stroke-width="1"></path>

  <!-- Fadenkreuz in der Bildmitte -->
  <g class="stroke-mark" stroke-width="1.4">
    <circle cx="166" cy="220" r="9"></circle>
    <path d="M166 204v32M150 220h32"></path>
  </g>

  <!-- Bemaßung Breite -->
  <g class="stroke-mark" stroke-width="1.2">
    <path d="M53 412v14M282 412v14"></path>
    <path d="M53 419h229"></path>
    <path d="M53 419l8-4v8zM282 419l-8-4v8z" class="fill-mark"></path>
  </g>
  <text x="167.5" y="436" text-anchor="middle" class="fill-mark font-mono" font-size="11" letter-spacing="1.5">210 mm</text>

  <!-- Bemaßung Höhe -->
  <g class="stroke-mark" stroke-width="1.2">
    <path d="M296 50h14M296 406h14"></path>
    <path d="M303 50v356"></path>
    <path d="M303 50l-4 8h8zM303 406l-4-8h8z" class="fill-mark"></path>
  </g>
  <text x="318" y="228" text-anchor="middle" class="fill-mark font-mono" font-size="11" letter-spacing="1.5" transform="rotate(90 318 228)">297 mm</text>

  <!-- Schriftfeld -->
  <text x="53" y="14" class="fill-graphite font-mono" font-size="10" letter-spacing="2">BLATT 03 / 03 · DIN A4</text>
</svg>
