---
import PdfIntake from './PdfIntake.astro';

// Oberfläche zum Teilen. Die Logik steht in src/scripts/split-tool.ts. Die Seitenvorschauen
// und Trennstellen baut das Skript, sobald eine Datei geladen ist.
const button =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
const primary = 'bg-signal text-on-signal shadow-sm hover:bg-signal-strong';
const secondary = 'border border-rule bg-sheet text-ink hover:border-rule-strong';
---

<section id="split-tool" class="crop-marks rounded-2xl border border-rule bg-sheet shadow-[0_1px_0_var(--color-rule),0_12px_40px_-16px_rgb(14_24_40/0.18)]">
  <div class="flex items-center justify-between border-b border-rule px-4 py-3 sm:px-5">
    <p class="label">Eingabe</p>
    <p data-count class="font-mono text-xs text-graphite">Keine Datei</p>
  </div>

  <div class="p-4 sm:p-5">
    <PdfIntake />

    <div data-board hidden class="mt-5">
      <p class="text-sm text-graphite">
        Klick zwischen zwei Seiten, um dort zu trennen. Nochmal klicken entfernt die Marke. Verschieben kannst du sie,
        indem du sie an eine andere Stelle ziehst.
      </p>
      <ol data-pages class="mt-5 flex flex-wrap gap-y-5" aria-label="Seiten der PDF"></ol>
    </div>
  </div>

  <div data-actions hidden class="border-t border-rule bg-sunken/60 px-4 py-4 sm:px-5">
    <ul data-parts class="flex flex-wrap gap-2" aria-label="Teile, die entstehen"></ul>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p data-hint class="text-xs text-graphite empty:hidden"></p>
      <div class="flex gap-2 sm:ml-auto">
        <button data-clear type="button" class:list={[button, secondary]}>Marken entfernen</button>
        <button data-split type="button" class:list={[button, primary]}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="5.5" cy="5.5" r="2.5"></circle>
            <circle cx="5.5" cy="14.5" r="2.5"></circle>
            <path d="M7.5 7l9 8M7.5 13l9-8" stroke-linecap="round"></path>
          </svg>
          Teilen
        </button>
      </div>
    </div>
    <p data-status role="status" aria-live="polite" class="mt-3 text-sm text-ink empty:hidden"></p>
  </div>

  <div data-result hidden class="border-t border-rule px-4 py-4 sm:px-5">
    <div class="rounded-xl border border-ok/30 bg-ok/8 p-4">
      <div class="flex items-center gap-3">
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ok text-sheet" aria-hidden="true">
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="m5 10.5 3.2 3L15 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <p data-result-title class="font-medium text-ink"></p>
      </div>
      <ul data-downloads class="mt-4 space-y-2"></ul>
    </div>
  </div>
</section>

<script>
  import '../scripts/split-tool';
</script>
