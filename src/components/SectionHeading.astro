---
interface Props {
  label: string;
  title: string;
  id?: string;
}
const { label, title, id } = Astro.props;
---

<div class="mb-8">
  <p class="label flex items-center gap-2.5">
    <span class="h-px w-6 bg-mark" aria-hidden="true"></span>
    {label}
  </p>
  <h2 id={id} class="mt-3 scroll-mt-24 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
</div>
