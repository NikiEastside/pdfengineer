---
import Logo from './Logo.astro';

const columns = [
  {
    title: 'Werkzeuge',
    links: [
      { href: '/pdf-zusammenfuegen/', label: 'PDF zusammenfügen' },
      { href: '/pdf-komprimieren/', label: 'PDF komprimieren' },
      { href: '/pdf-teilen/', label: 'PDF teilen' },
      { href: '/pdf-seiten-sortieren/', label: 'PDF-Seiten sortieren' },
      { href: '/pdf-metadaten-aendern/', label: 'PDF-Metadaten ändern' },
      { href: '/bilder-in-pdf/', label: 'Bilder in PDF' },
      { href: '/pdf-in-bild/', label: 'PDF in Bild' },
      { href: '/pdf-wasserzeichen/', label: 'Wasserzeichen' },
      { href: '/pdf-seitenzahlen/', label: 'Seitenzahlen' },
    ],
  },
  {
    title: 'Projekt',
    links: [
      { href: '/sicherheit/', label: 'Sicherheit' },
      { href: 'https://github.com/NikiEastside/pdfengineer', label: 'Quellcode' },
      { href: 'https://github.com/NikiEastside/pdfengineer/blob/dev/LICENSE', label: 'Lizenz (AGPL-3.0)' },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { href: '/impressum/', label: 'Impressum' },
      { href: '/datenschutz/', label: 'Datenschutz' },
    ],
  },
];
---

<footer class="mt-24 border-t border-rule bg-sheet">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5">
        <Logo class="size-6" />
        <span class="font-mono text-xs font-semibold tracking-[0.16em] uppercase">
          <span class="text-signal">PDF</span> Engineer
        </span>
      </a>
      <p class="mt-4 max-w-xs text-sm text-graphite">
        PDF-Werkzeuge, die direkt in deinem Browser laufen. Deine Dateien bleiben bei dir.
      </p>
    </div>
    {
      columns.map((column) => (
        <div>
          <p class="label">{column.title}</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-graphite transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-rule">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-graphite sm:flex-row sm:justify-between sm:px-6">
      <p>© {new Date().getFullYear()} pdfengineer.de · Freie Software unter der AGPL-3.0</p>
      <p class="font-mono tracking-wide">Verarbeitung: lokal · Upload: keiner</p>
    </div>
  </div>
</footer>
