---
// Eingabe für Werkzeuge, die mit genau einer PDF arbeiten (Teilen, Sortieren): Ablagefeld,
// danach eine Zeile mit der geladenen Datei, bei Bedarf das Passwortfeld und Meldungen. Die
// Logik dazu steht in src/scripts/single-pdf.ts.
import Dropzone from './Dropzone.astro';

const small =
  'inline-flex items-center justify-center rounded-lg border border-rule bg-sheet px-3 py-1.5 text-xs font-medium text-ink transition hover:border-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
---

<div data-intake>
  <Dropzone multiple={false} />
</div>

<div data-file hidden class="flex items-center gap-3 rounded-xl border border-rule bg-sunken/60 p-3">
  <div class="min-w-0 flex-1">
    <p data-file-name class="truncate text-sm font-medium text-ink"></p>
    <p data-file-meta class="mt-0.5 font-mono text-[11px] tracking-wide text-graphite"></p>
  </div>
  <button data-reset type="button" class={small}>Andere Datei</button>
</div>

<form data-password hidden class="mt-3 flex max-w-sm items-center gap-2">
  <input
    name="password"
    type="password"
    autocomplete="off"
    placeholder="Passwort"
    aria-label="Passwort für die PDF"
    class="min-w-0 flex-1 rounded-md border border-rule-strong bg-sheet px-2.5 py-1.5 text-sm text-ink placeholder:text-graphite focus:border-signal focus:outline-none"
  />
  <button type="submit" class="rounded-md bg-signal px-3 py-1.5 text-xs font-medium text-on-signal transition hover:bg-signal-strong">Öffnen</button>
</form>

<p data-message role="status" aria-live="polite" class="mt-3 font-mono text-[11px] tracking-wide text-danger empty:hidden"></p>
