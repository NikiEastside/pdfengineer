---
import Dropzone from './Dropzone.astro';

// Oberfläche für Bilder in PDF. Die Logik steht in src/scripts/image-tool.ts.
const button =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
const primary = 'bg-signal text-on-signal shadow-sm hover:bg-signal-strong';
const secondary = 'border border-rule bg-sheet text-ink hover:border-rule-strong';
const layouts = [
  { value: 'a4', label: 'A4', note: 'Mit 10 mm Rand. Hoch- oder Querformat wählst du darunter.' },
  { value: 'image', label: 'Wie das Bild', note: 'Jede Seite genau so groß wie ihr Bild, ohne Rand.' },
];
const orientations = [
  { value: 'auto', label: 'Automatisch' },
  { value: 'portrait', label: 'Hochformat' },
  { value: 'landscape', label: 'Querformat' },
];
---

<section id="image-tool" class="crop-marks rounded-2xl border border-rule bg-sheet shadow-[0_1px_0_var(--color-rule),0_12px_40px_-16px_rgb(14_24_40/0.18)]">
  <div class="flex items-center justify-between border-b border-rule px-4 py-3 sm:px-5">
    <p class="label">Eingabe</p>
    <p data-count class="font-mono text-xs text-graphite">0 Bilder</p>
  </div>

  <div class="p-4 sm:p-5">
    <Dropzone images />
    <ol data-list class="mt-4 space-y-2 empty:mt-0" aria-label="Ausgewählte Bilder in der Reihenfolge der Seiten"></ol>
  </div>

  <div data-actions hidden class="border-t border-rule bg-sunken/60 px-4 py-4 sm:px-5">
    <fieldset>
      <legend class="label">Seitenformat</legend>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          layouts.map((layout) => (
            <label class="relative flex cursor-pointer flex-col rounded-xl border border-rule bg-sheet p-3 transition hover:border-rule-strong has-checked:border-signal has-checked:shadow-[inset_0_0_0_1px_var(--color-signal)] has-focus-visible:outline-2 has-focus-visible:outline-signal">
              <input type="radio" name="layout" value={layout.value} checked={layout.value === 'a4'} class="sr-only" />
              <span class="font-medium text-ink">{layout.label}</span>
              <span class="mt-1 text-xs leading-snug text-graphite">{layout.note}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset data-orientation class="mt-4">
      <legend class="label">Ausrichtung</legend>
      <div class="mt-3 inline-flex flex-wrap rounded-xl border border-rule bg-sheet p-1">
        {
          orientations.map((orientation) => (
            <label class="cursor-pointer rounded-lg px-3 py-1.5 text-sm text-graphite transition hover:text-ink has-checked:bg-signal has-checked:text-on-signal has-focus-visible:outline-2 has-focus-visible:outline-signal">
              <input type="radio" name="orientation" value={orientation.value} checked={orientation.value === 'auto'} class="sr-only" />
              {orientation.label}
            </label>
          ))
        }
      </div>
      <p class="mt-2 text-xs text-graphite">Automatisch heißt: Querbilder auf Querseiten, Hochbilder auf Hochseiten.</p>
    </fieldset>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p data-summary class="font-mono text-xs tracking-wide text-ink"></p>
        <p data-hint class="mt-1 text-xs text-graphite empty:hidden"></p>
      </div>
      <div class="flex gap-2">
        <button data-clear type="button" class:list={[button, secondary]}>Alle entfernen</button>
        <button data-convert type="button" class:list={[button, primary]}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="4" width="9" height="12" rx="1.5"></rect>
            <path d="M14 10h4m0 0-2-2m2 2-2 2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          In PDF umwandeln
        </button>
      </div>
    </div>
    <p data-status role="status" aria-live="polite" class="mt-3 text-sm text-ink empty:hidden"></p>
  </div>

  <div data-result hidden class="border-t border-rule px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-4 rounded-xl border border-ok/30 bg-ok/8 p-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-ok text-sheet" aria-hidden="true">
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="m5 10.5 3.2 3L15 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <div>
          <p class="font-medium text-ink">Deine PDF ist fertig</p>
          <p data-result-text class="mt-0.5 text-sm text-graphite"></p>
        </div>
      </div>
      <a data-download class:list={[button, primary]} href="#">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Herunterladen
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/image-tool';
</script>
