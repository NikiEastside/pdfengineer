---
// Bildmarke: ein Blatt mit Eselsohr auf Signalblau. Dieselbe Form steckt in public/favicon.svg.
interface Props {
  class?: string;
}
const { class: className = 'size-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" class="fill-signal"></rect>
  <path d="M10 6.5h8.5l5 5V25.5H10z" class="fill-sheet"></path>
  <path d="M18.5 6.5v5h5" fill="none" class="stroke-signal" stroke-width="1.6" stroke-linejoin="round"></path>
  <path d="M13 16h7.5M13 19.5h7.5M13 23h4.5" class="stroke-signal" stroke-width="1.6" stroke-linecap="round"></path>
</svg>
