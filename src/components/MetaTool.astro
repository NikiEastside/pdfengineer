---
import PdfIntake from './PdfIntake.astro';
import { DATE_FIELDS, TEXT_FIELDS } from '../lib/metadata-fields';

// Oberfläche zum Ändern der Metadaten. Die Logik steht in src/scripts/meta-tool.ts.
const button =
  'inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40';
const primary = 'bg-signal text-on-signal shadow-sm hover:bg-signal-strong';
const secondary = 'border border-rule bg-sheet text-ink hover:border-rule-strong';
const input =
  'w-full rounded-md border border-rule-strong bg-sheet px-3 py-2 text-sm text-ink placeholder:text-graphite/70 transition focus:border-signal focus:outline-none disabled:opacity-60 data-changed:border-signal data-changed:bg-signal/5';
const fields = [
  ...Object.entries(TEXT_FIELDS).map(([name, field]) => ({ name, label: field.label, type: 'text' as const })),
  ...Object.entries(DATE_FIELDS).map(([name, field]) => ({ name, label: field.label, type: 'datetime-local' as const })),
];
---

<section id="meta-tool" class="crop-marks rounded-2xl border border-rule bg-sheet shadow-[0_1px_0_var(--color-rule),0_12px_40px_-16px_rgb(14_24_40/0.18)]">
  <div class="flex items-center justify-between border-b border-rule px-4 py-3 sm:px-5">
    <p class="label">Eingabe</p>
    <p data-count class="font-mono text-xs text-graphite">Keine Datei</p>
  </div>

  <div class="p-4 sm:p-5">
    <PdfIntake />

    <form data-form hidden class="mt-5" autocomplete="off">
      <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
        {
          fields.map((field) => (
            <label class="block">
              <span class="label">{field.label}</span>
              <input data-field={field.name} name={field.name} type={field.type} class:list={[input, 'mt-1.5']} placeholder="leer" />
            </label>
          ))
        }
      </div>

      <div data-extra hidden class="mt-5 rounded-xl border border-rule bg-sunken/60 p-4 text-sm">
        <p data-xmp hidden class="text-graphite">
          Diese PDF enthält die Angaben zusätzlich als <strong class="font-medium text-ink">XMP</strong>, das viele
          Programme bevorzugt anzeigen. Beim Speichern wird es entfernt, damit überall deine Angaben gelten.
        </p>
        <div data-custom hidden class="[&:not(:first-child)]:mt-3">
          <p class="text-graphite">Weitere Einträge, die beim Speichern entfernt werden:</p>
          <ul data-custom-list class="mt-2 space-y-1 font-mono text-xs text-ink"></ul>
        </div>
      </div>
    </form>
  </div>

  <div data-actions hidden class="border-t border-rule bg-sunken/60 px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p data-summary class="font-mono text-xs tracking-wide text-ink"></p>
        <p data-hint class="mt-1 text-xs text-graphite empty:hidden"></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button data-clear type="button" class:list={[button, secondary]}>Alle entfernen</button>
        <button data-restore type="button" class:list={[button, secondary]}>Zurücksetzen</button>
        <button data-save type="button" class:list={[button, primary]}>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Speichern
        </button>
      </div>
    </div>
    <p data-status role="status" aria-live="polite" class="mt-3 text-sm text-ink empty:hidden"></p>
  </div>

  <div data-result hidden class="border-t border-rule px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-4 rounded-xl border border-ok/30 bg-ok/8 p-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-ok text-sheet" aria-hidden="true">
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="m5 10.5 3.2 3L15 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <div>
          <p class="font-medium text-ink">Metadaten gespeichert</p>
          <p data-result-text class="mt-0.5 text-sm text-graphite"></p>
        </div>
      </div>
      <a data-download class:list={[button, primary]} href="#">Herunterladen</a>
    </div>
  </div>
</section>

<script>
  import '../scripts/meta-tool';
</script>
