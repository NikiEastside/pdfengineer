# Kopiere diese Datei zu ".env.deploy" und trage die Strato-SFTP-Zugangsdaten ein.
# Der Zielordner ist ein eigener Ordner neben /htdocs.
# ".env.deploy" ist in .gitignore und wird NIEMALS committet.

STRATO_FTP_HOST=sftp.deinpaket.de
STRATO_FTP_USER=dein-sftp-benutzername
STRATO_FTP_PASSWORD=dein-sftp-passwort

# Ordner NEBEN /htdocs, nicht darin. In /htdocs liegt eine andere Seite, deploy.sh bricht dort ab.
STRATO_REMOTE_PATH=/ganymed

# SFTP-Port, falls Strato einen abweichenden Port angibt (Standard: 22).
STRATO_SFTP_PORT=22
